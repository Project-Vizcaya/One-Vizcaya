rules_version = '2';
// ═══════════════════════════════════════════════════════════════════════════
//  One Vizcaya — Governance enforced at the database layer (not just the UI)
//  ---------------------------------------------------------------------------
//  This file is the TECHNICAL LAYER of the architecture documented in
//    docs/Architecture-Governance-Design.md   (committee-facing, four layers)
//    docs/Governance-Architecture.md           (condensed Barangay→Region II)
//  It mirrors the real government hierarchy:
//    Barangay → City/Municipality → Province → Region II
//
//  Design rule (from the docs)        →  Enforced here by
//  ---------------------------------------------------------------------------
//  Bounded authority per role         →  role() + isMunicipalAdmin()/etc.;
//                                         barangay scoping uses actorMunicipality()
//                                         AND actorBarangay()
//  Single accountable owner           →  reports rules; escalation is a guarded
//                                         write (approvingEscalation())
//  Escalation control (no auto-jump)  →  Municipal admin of the OWNING town only,
//                                         must stamp escalatedBy
//  Append-only audit trail            →  audit_logs (create by admins, mutate by
//                                         super_admin only); Cloud Functions write it
//  Tenant data isolation              →  municipality/barangay equality checks on
//                                         reads of reports & verificationRequests
//  Verified-resident reporting        →  residencyStatus gate on report create;
//                                         'certified' grantable only server-side
//
//  Authority is hierarchical and non-overlapping: a higher tier may READ what is
//  below it, but may not silently override a lower tier's ownership — every
//  transfer is an explicit, logged action.
// ═══════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Auth helpers ───────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    // Check custom token claim first (fast), fall back to Firestore doc (safe)
    function role() {
      return isAuth()
        ? request.auth.token.get('role',
            get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.get('role', 'citizen'))
        : 'citizen';
    }

    // ─── Role hierarchy (Barangay → Municipal → Provincial → Region/Super) ───
    //   super_admin        → unrestricted access to everything
    //   provincial_admin   → read/write/delete across all municipalities
    //   admin              → legacy role, same power as provincial_admin
    //   municipal_admin    → read/update reports; manage announcements & responders;
    //                        approve Municipal→Provincial escalations & residents
    //   barangay_admin     → certify residents of their barangay (lowest tier)
    //   citizen            → own data only

    function isSuperAdmin() {
      return isAuth() && role() == 'super_admin';
    }

    function isProvincialAdmin() {
      return isAuth() && role() in ['provincial_admin', 'admin', 'super_admin'];
    }

    function isMunicipalAdmin() {
      return isAuth() && role() in ['municipal_admin', 'provincial_admin', 'admin', 'super_admin'];
    }

    // Any admin level (used for broad read access). NOTE: barangay_admin is
    // intentionally excluded here — it is not a broad-read role.
    function isAdmin() {
      return isAuth() && role() in ['municipal_admin', 'provincial_admin', 'admin', 'super_admin'];
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // The acting admin's municipality (from their user profile), used to enforce
    // that only the OWNING municipality's admin may approve an escalation.
    function actorMunicipality() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('municipality', '');
    }

    // The acting admin's barangay (from their user profile). Used to confine a
    // Barangay admin to certifying ONLY residents of their own barangay.
    function actorBarangay() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('barangay', '');
    }

    // A Barangay admin may act on a report ONLY when it belongs to their own
    // municipality AND their own barangay (single-owner accountability at the
    // base tier). [data] is a report document's data map.
    function barangayScoped(data) {
      return role() == 'barangay_admin'
        && actorMunicipality() == data.municipality
        && actorBarangay() == data.get('barangay', '');
    }

    // A Municipal admin may act ONLY on records in their OWN municipality — they
    // must not reach another town's reports/dashboard. Provincial+ are unscoped.
    // [data] is a document's data map that carries a `municipality` field.
    function municipalScoped(data) {
      return role() == 'municipal_admin'
        && actorMunicipality() == data.municipality;
    }

    // True when this report update is flipping escalatedToProvince false → true
    // (i.e. the Municipal → Provincial approval handoff).
    function approvingEscalation() {
      return resource.data.get('escalatedToProvince', false) == false
        && request.resource.data.get('escalatedToProvince', false) == true;
    }

    // ─── Report disposition (PDRRMO §8) ───────────────────────────────────────
    // A report can be closed WITHOUT action as false / duplicate / incomplete /
    // unverifiable — recorded, never silently deleted. The fields are written
    // together and only by an in-scope admin, who must stamp their own uid.

    function dispositionFields() {
      return ['status', 'disposition', 'dispositionReason', 'dispositionBy',
              'dispositionAt', 'duplicateOf'];
    }

    // Admin-side check, applied to every admin update of a report:
    //  - status 'closed' is only valid with a disposition (and vice versa);
    //  - a disposition needs an allowed value, a real reason (>= 5 chars) and
    //    dispositionBy == the acting admin;
    //  - clearing a disposition (re-opening) must also move off 'closed'.
    //  - checked only when one of those fields CHANGES, so another admin can
    //    still add notes to a closed report;
    //  - dispositionAt must be the server's time, not a client-chosen one.
    function validDisposition() {
      let d = request.resource.data;
      let disp = d.get('disposition', null);
      let changed = d.diff(resource.data).affectedKeys().hasAny(dispositionFields());
      // Re-opening (clearing an existing disposition) must be attributed too.
      let reopening = resource.data.get('disposition', null) != null;
      return !changed
          || (disp == null && d.get('status', '') != 'closed'
              && (!reopening || d.get('reopenedBy', '') == request.auth.uid))
          || (disp in ['false_report', 'duplicate', 'incomplete', 'unverifiable']
              && d.get('status', '') == 'closed'
              && d.get('dispositionReason', '') is string
              && d.get('dispositionReason', '').size() >= 5
              && d.get('dispositionBy', '') == request.auth.uid
              && d.get('dispositionAt', null) == request.time);
    }

    // Referral to a named office (P2, PDRRMO): who the report was handed to,
    // stamped with the referring admin and the server time. It may be replaced
    // (re-referred) but never removed; every change is audited by
    // auditReportReferral. Checked only when `referral` changes.
    function referralOfficeTypes() {
      return ['MDRRMO', 'BDRRMC', 'PDRRMO', 'BFP', 'PNP', 'MHO', 'MSWDO',
              'MEO', 'DPWH', 'Other'];
    }

    function validReferral() {
      let d = request.resource.data;
      let r = d.get('referral', null);
      return !d.diff(resource.data).affectedKeys().hasAny(['referral'])
          || (r is map
              && r.keys().hasOnly(['officeType', 'officeName', 'contact', 'note', 'by', 'at'])
              && r.get('officeType', '') in referralOfficeTypes()
              && r.get('officeName', '') is string
              && r.get('officeName', '').size() >= 2
              && r.get('officeName', '').size() <= 120
              && r.get('contact', '') is string && r.get('contact', '').size() <= 80
              && r.get('note', '') is string && r.get('note', '').size() <= 500
              && r.get('by', '') == request.auth.uid
              && r.get('at', null) == request.time);
    }

    // Status lifecycle (P3, PDRRMO §8): a report may become 'solved' only
    // from 'ongoing', with a resolution note (what was done, 10-1000 chars)
    // and resolutionBy == the acting admin. Other steps may be skipped and
    // moving back is allowed. Closing without action is validDisposition().
    function validLifecycle() {
      let d = request.resource.data;
      let toSolved = d.get('status', '') == 'solved'
                     && resource.data.get('status', '') != 'solved';
      return !toSolved
          || (resource.data.get('status', '') == 'ongoing'
              && d.get('resolutionNote', '') is string
              && d.get('resolutionNote', '').size() >= 10
              && d.get('resolutionNote', '').size() <= 1000
              && d.get('resolutionBy', '') == request.auth.uid);
    }

    // Proxy reporting (P3, PDRRMO §11): a report filed for a resident without
    // a smartphone. It is filed under the FILER's own account (so status
    // updates reach the filer, who relays them) with `onBehalfOf` naming the
    // resident. Who may file for someone else:
    //   - a Barangay admin, for their own barangay;
    //   - a Municipal admin, for their own municipality;
    //   - a Provincial / Super admin, anywhere;
    //   - a resident whose residency is CERTIFIED, e.g. for a family member.
    function validOnBehalf() {
      let d = request.resource.data;
      let p = d.get('onBehalfOf', null);
      return p == null
          || (p is map
              && p.keys().hasOnly(['name', 'contact', 'relationship'])
              && p.get('name', '') is string
              && p.get('name', '').size() >= 2 && p.get('name', '').size() <= 80
              && p.get('contact', '') is string && p.get('contact', '').size() <= 40
              && p.get('relationship', '') is string && p.get('relationship', '').size() <= 40
              && (isProvincialAdmin()
                  || (municipalScoped(d) && actorMunicipality() != '')
                  || (barangayScoped(d) && actorBarangay() != '')
                  || get(/databases/$(database)/documents/users/$(request.auth.uid))
                       .data.get('residencyStatus', '') == 'certified'));
    }

    // ─── Super admin bypass ─────────────────────────────────────────────────
    // super_admin can read everything and write almost everything — EXCEPT the
    // collections only the server may write. Rules are OR-ed, so an
    // `allow write: if false` on those collections could not stop this bypass;
    // the exclusion has to live here. Without it a super admin client could
    // falsify official PAGASA data, or approve an automated alert by editing
    // its draft directly and skip decideAlertDraft's checks.
    match /{document=**} {
      allow read:  if isSuperAdmin();
      // request.path is /databases/(default)/documents/<collection>/..., so
      // [3] is the top-level collection. (Indexing the `document` wildcard
      // itself is an evaluation error — which denies EVERY write and would
      // silently remove the bypass; tests/emulator guards against that.)
      allow write: if isSuperAdmin() && !(request.path[3] in serverOnlyCollections())
                    && !(request.method == 'delete' && isReportPath())
                    // Broadcasts follow their own rule, so a super admin also
                    // needs a second approver for urgent/province-wide alerts.
                    && request.path[3] != 'broadcasts';
    }

    // users/{uid}/reports/{id} — deleted only via deleteReportWithReason.
    function isReportPath() {
      return string(request.path).matches('.*/users/[^/]+/reports/[^/]+$');
    }

    function serverOnlyCollections() {
      return ['pagasa_products', 'alert_drafts', 'system_health'];
    }

    // ─── User profiles ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      // A user may create their OWN profile as a citizen; a provincial admin may
      // create a citizen profile too. Assigning any ELEVATED role on create is a
      // super-admin power (or the nominate → approve workflow), never a direct
      // client write — role() falls back to this field, so it must be guarded.
      allow create: if (isOwner(userId)
                        && request.resource.data.get('role', 'citizen') == 'citizen')
                    || isSuperAdmin()
                    || (isProvincialAdmin()
                        && request.resource.data.get('role', 'citizen') == 'citizen');
      // A user may update their OWN profile but must NOT change their 'role'
      // (privilege guard) nor self-grant a 'certified' residency status — that
      // is only set server-side after an LGU admin approves a residency request.
      // A provincial admin may edit a user's profile fields but NOT their role:
      // role changes only happen server-side via onRoleRequestDecision /
      // setAdminRole (#8 nominate → approve). super_admin bypass covers direct
      // super-admin role edits.
      allow update: if (isOwner(userId)
                        && request.resource.data.get('role', 'citizen')
                           == resource.data.get('role', 'citizen')
                        && (request.resource.data.get('residencyStatus', 'unverified')
                              == resource.data.get('residencyStatus', 'unverified')
                            || request.resource.data.get('residencyStatus', 'unverified')
                                 in ['unverified', 'gps_verified']))
                    || (isProvincialAdmin()
                        && request.resource.data.get('role', 'citizen')
                           == resource.data.get('role', 'citizen'));
      // A user may erase their OWN profile (RA 10173 right to erasure). Their
      // reports are NOT deletable here (see reports rule) — they are archived
      // and retained as official LGU records on account deletion.
      allow delete: if isOwner(userId) || isProvincialAdmin();

      // Per-user reports sub-collection.
      // Anonymous reporting is NOT allowed: every report must carry the
      // verified submitter identity (userId == the owning uid + a phone number).
      // Enforced here at the data layer, not just in the UI.
      match /reports/{reportId} {
        allow read:   if isOwner(userId)
                      || isProvincialAdmin()
                      || municipalScoped(resource.data)
                      || barangayScoped(resource.data);
        // Residency gate (Option 3): only a verified Nueva Vizcaya resident may
        // file a report. residencyStatus must be gps_verified or certified.
        // Existing users (created before this feature, with no residencyStatus
        // field) default to 'grandfathered' so the rollout never blocks them.
        allow create: if isOwner(userId)
                      && request.resource.data.userId == userId
                      && request.resource.data.userPhone is string
                      && request.resource.data.userPhone.size() > 0
                      && request.resource.data.isAnonymous == false
                      && get(/databases/$(database)/documents/users/$(userId))
                           .data.get('residencyStatus', 'grandfathered')
                           in ['gps_verified', 'certified', 'grandfathered']
                      && validOnBehalf();
        // Approval chain (Municipal → Provincial): an escalation (turning on
        // escalatedToProvince) may ONLY be approved by a Municipal admin of the
        // report's own municipality, and must stamp escalatedBy with their uid.
        // All other updates follow the normal owner/admin permissions. (super
        // admin is covered by the bypass above.)
        //
        // The owner may update their report but may NOT touch its status or
        // disposition — previously `isOwner(userId)` allowed any field, so a
        // reporter could mark their own report solved or clear a "false
        // report" disposition. (Citizens never write their report document in
        // the app; ratings go to the feedback subcollection.)
        allow update: if ((isProvincialAdmin() && !approvingEscalation())
                         || (municipalScoped(resource.data) && !approvingEscalation())
                         || (barangayScoped(resource.data) && !approvingEscalation())
                         || (approvingEscalation()
                             && municipalScoped(resource.data)
                             && request.resource.data.escalatedBy == request.auth.uid))
                         && validDisposition()
                         && validReferral()
                         && validLifecycle()
                      || (isOwner(userId)
                          && !request.resource.data.diff(resource.data)
                               .affectedKeys().hasAny(dispositionFields().concat(['referral', 'resolutionNote', 'resolutionBy', 'onBehalfOf'])));
        // Deletion goes ONLY through the deleteReportWithReason callable,
        // which checks the caller, requires a reason and records who did it.
        // (A client delete could not be attributed.)
        allow delete: if false;
      }

      // Per-user notifications
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
        allow read:        if isAdmin();
        allow write:       if isAdmin(); // Cloud Functions write here
      }

      // Per-user feedback on resolved reports
      match /feedback/{feedbackId} {
        allow read, write: if isOwner(userId);
        allow read:        if isAdmin();
      }

      // Per-user data-subject requests (RA 10173: access/correction/erasure/etc.)
      // Citizens file and read their own; admins (the DPO) read and update status.
      match /dataRequests/{requestId} {
        allow read, create: if isOwner(userId);
        allow read, update: if isAdmin();
        allow delete:       if isProvincialAdmin();
      }
    }

    // ─── Data-subject requests (collectionGroup) ─────────────────────────────
    // Lets the DPO / admins list every privacy request across all users.
    match /{path=**}/dataRequests/{requestId} {
      allow read, update: if isAdmin();
    }

    // ─── Citizen feedback (collectionGroup) ──────────────────────────────────
    // Lets admins read satisfaction ratings across all reports for analytics.
    match /{path=**}/feedback/{feedbackId} {
      allow read: if isAdmin();
    }

    // ─── CollectionGroup query ───────────────────────────────────────────────
    // Citizens need read access ONLY for the community "Recently Resolved" feed,
    // which queries where status == 'solved'. Restricting the rule to solved
    // reports forces that filter and stops citizens from reading other people's
    // open reports (descriptions, phone, GPS) via a collectionGroup query.
    // Owners still read their own reports through the users/{uid}/reports rule.
    // Admins can read everything for triage.
    match /{path=**}/reports/{reportId} {
      allow read:   if isProvincialAdmin()
                    || municipalScoped(resource.data)
                    || barangayScoped(resource.data)
                    || (isAuth() && resource.data.status == 'solved');
      // NOTE: this collection-group match ALSO matches users/{uid}/reports/{id},
      // and Firestore ORs every matching rule. Any constraint on report updates
      // must therefore appear here as well as in the nested rule, or it is
      // silently bypassed — validDisposition() was, until rules tests caught it.
      allow update: if ((isProvincialAdmin() && !approvingEscalation())
                       || (municipalScoped(resource.data) && !approvingEscalation())
                       || (barangayScoped(resource.data) && !approvingEscalation())
                       || (approvingEscalation()
                           && municipalScoped(resource.data)
                           && request.resource.data.escalatedBy == request.auth.uid))
                       && validDisposition()
                       && validReferral()
                       && validLifecycle();
      allow delete: if false; // see the nested reports rule
    }

    // ─── Announcements ───────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read:          if isAuth();
      // Provincial+ may post for any scope (incl. province-wide). A Municipal
      // admin may ONLY post announcements tagged with their OWN municipality —
      // not "all" and not another town. The actorMunicipality() != '' guard
      // stops an admin with no municipality on their profile from matching an
      // empty municipality field, which onNewAnnouncement treats as "All".
      // `delivery` (push counts) is written only by onNewAnnouncement.
      allow create, update: if (isProvincialAdmin()
                            || (role() == 'municipal_admin'
                                && actorMunicipality() != ''
                                && request.resource.data.get('municipality', '')
                                   == actorMunicipality()))
                            && request.resource.data.get('delivery', null)
                               == (resource == null ? null : resource.data.get('delivery', null));
      allow delete:        if isProvincialAdmin();
    }

    // ─── Emergency responders ────────────────────────────────────────────────
    match /responders/{responderId} {
      allow read:          if isAuth();
      allow create, update: if isMunicipalAdmin();
      allow delete:        if isProvincialAdmin();
    }

    // ─── FCM broadcast records ───────────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      // Residents may re-read the alerts addressed to them (P2 inbox), using
      // the same targeting as onNewBroadcast: province-wide (scope "all" /
      // legacy "All Province"), or their profile town in `scope` (approved
      // automated alerts, legacy) or in `municipality` (admin composer).
      allow read:   if isAdmin()
                    || (isAuth()
                        && (resource.data.get('scope', '') in ['all', 'All Province']
                            || (actorMunicipality() != ''
                                && (resource.data.get('scope', '') == actorMunicipality()
                                    || resource.data.get('municipality', '') == actorMunicipality()))));
      // Provincial+ may broadcast to any town; a Municipal admin ONLY to their
      // OWN municipality. onNewBroadcast targets `municipality` when it is set,
      // and it is now required, so a direct write always reaches one town.
      // The actorMunicipality() != '' guard stops an admin with no
      // municipality on their profile from matching an empty field.
      // `delivery` (push counts) is written only by onNewBroadcast.
      //
      // Second approver (P2, PDRRMO §2): a client may only create a ROUTINE
      // SINGLE-TOWN broadcast directly — not urgent, and with `municipality`
      // set, which onNewBroadcast uses as the target. Urgent or province-wide
      // alerts go through proposeAdminAlert and need a second admin's approval
      // in decideAlertDraft, which writes the broadcast server-side.
      allow create: if (isProvincialAdmin()
                    || (role() == 'municipal_admin'
                        && actorMunicipality() != ''
                        && request.resource.data.get('municipality', '')
                             == actorMunicipality()))
                    && !('delivery' in request.resource.data)
                    && request.resource.data.get('urgent', false) == false
                    && request.resource.data.get('municipality', '') is string
                    && request.resource.data.get('municipality', '') != '';
      allow delete: if isProvincialAdmin();
    }

    // ─── Audit logs (append-only for admins; only super_admin can delete) ────
    match /audit_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // ─── Automated alert drafts (PDRRMO §2: a human approves every alert) ─────
    // Written only by the weather watchers and decided only through the
    // decideAlertDraft callable (Admin SDK). Readable by the admins who may
    // decide them: provincial+ anywhere, a municipal admin for their own town.
    match /alert_drafts/{draftId} {
      allow read:  if isProvincialAdmin() || municipalScoped(resource.data);
      allow write: if false;
    }

    // ─── Official PAGASA products (written only by pagasaRegionalWatch) ───────
    // Public weather information republished from PAGASA with attribution.
    // Any signed-in user may read it. No client write is granted here — the
    // Admin SDK in Cloud Functions bypasses rules — though the global
    // super_admin bypass above still applies, as it does to every collection.
    match /pagasa_products/{docId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ─── App config ──────────────────────────────────────────────────────────
    match /config/{docId} {
      allow read:  if isAdmin();
      allow write: if isProvincialAdmin();
    }

    // ─── Rate limit counters ─────────────────────────────────────────────────
    match /rate_limits/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ─── Demo / seed meta ────────────────────────────────────────────────────
    match /demo_meta/{docId} {
      allow read:  if isAdmin();
      allow write: if isProvincialAdmin();
    }

    // ─── Residency certification requests (Option 3, certified path) ──────────
    // A citizen files a request to be certified as a Nueva Vizcaya resident;
    // their Barangay admin (or the Municipal admin of that town, as fallback)
    // reviews and decides. Approval triggers a server-side function that sets
    // the citizen's residencyStatus = 'certified'.
    match /verificationRequests/{reqId} {
      // Citizen files their own request (must reference their own uid).
      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Citizen reads their own. Province-wide for provincial+. A Municipal admin
      // is scoped to their whole town. A Barangay admin is confined to ONLY their
      // own barangay (single-owner accountability at the base tier).
      allow read:   if (isAuth() && resource.data.uid == request.auth.uid)
                    || isProvincialAdmin()
                    || (isMunicipalAdmin()
                        && actorMunicipality() == resource.data.municipality)
                    || (role() == 'barangay_admin'
                        && actorMunicipality() == resource.data.municipality
                        && actorBarangay() == resource.data.barangay);
      // Same scoping for deciding (approve/reject): provincial+ anywhere, a
      // Municipal admin within their town, a Barangay admin ONLY within their
      // own barangay. Every decision is stamped + audited server-side.
      allow update: if isProvincialAdmin()
                    || (isMunicipalAdmin()
                        && actorMunicipality() == resource.data.municipality)
                    || (role() == 'barangay_admin'
                        && actorMunicipality() == resource.data.municipality
                        && actorBarangay() == resource.data.barangay);
      allow delete: if isProvincialAdmin();
    }

    // ─── Role requests (#8: nominate → super-admin approval) ─────────────────
    // An admin NOMINATES a user for a role (create, status 'pending'); a
    // super_admin approves/rejects (update → status). The actual role write
    // happens ONLY server-side in onRoleRequestDecision, so no admin below the
    // super admin can elevate anyone directly. The 'admin' (legacy) role is
    // retired and may not be requested.
    match /roleRequests/{reqId} {
      allow read:   if isAdmin();
      // Any municipal-or-higher admin may nominate. The request must name a
      // target and a valid, non-legacy role, and start pending with the
      // nominator stamped as themselves.
      allow create: if isMunicipalAdmin()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.nominatedBy == request.auth.uid
                    && request.resource.data.targetUid is string
                    && request.resource.data.requestedRole in
                         ['citizen', 'barangay_admin', 'municipal_admin',
                          'provincial_admin', 'super_admin'];
      // Only a super_admin decides. (The super_admin bypass above already grants
      // this; stated explicitly for clarity and in case the bypass is tightened.)
      allow update, delete: if isSuperAdmin();
    }

    // ─── Emergency SOS beacons (live-location dispatch) ──────────────────────
    // A citizen presses SOS → an alert is created with their live position, then
    // updated in place while the emergency is active. Admins see it in real time
    // scoped to their tier (province-wide / their town / their barangay) so
    // responders can be dispatched to the exact spot — even if the caller can't
    // speak. Location is sensitive PII: only the owner and in-scope admins read
    // it, and it is only written by the owner (server bypass covers functions).
    match /sos_alerts/{alertId} {
      // Citizens create their OWN beacon, active + unverified — they cannot
      // self-verify or pre-clear an abuse flag (those are operator/server only).
      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.get('verified', false) == false;
      allow read:   if isOwner(resource.data.uid)
                    || isProvincialAdmin()
                    || municipalScoped(resource.data)
                    || barangayScoped(resource.data);
      // The owner keeps their own beacon updated (live location, cancel) but may
      // NOT change verification, the abuse flag, or the disposition — an
      // in-scope admin owns those (verify → dispatch → resolve).
      allow update: if (isOwner(resource.data.uid)
                        && request.resource.data.get('verified', false)
                           == resource.data.get('verified', false)
                        && request.resource.data.get('flagged', false)
                           == resource.data.get('flagged', false)
                        && request.resource.data.get('disposition', '')
                           == resource.data.get('disposition', ''))
                    || isProvincialAdmin()
                    || municipalScoped(resource.data)
                    || barangayScoped(resource.data);
      allow delete: if isOwner(resource.data.uid) || isProvincialAdmin();
    }
  }
}
