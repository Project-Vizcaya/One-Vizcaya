# Command Hub prototype settings. Copy to .env.local and change the secrets.

# Signs the demo sign-in cookie. REQUIRED in production builds.
HUB_SESSION_SECRET=change-me-session-secret

# Shared with One Vizcaya's Cloud Functions (Secret Manager: HUB_BRIDGE_SECRET).
# Signs reports coming in from One Vizcaya and status updates going back.
HUB_BRIDGE_SECRET=change-me-bridge-secret

# One Vizcaya's incidentStatusUpdate function. Empty = citizens get no updates.
# e.g. https://us-central1-one-vizcaya-app.cloudfunctions.net/incidentStatusUpdate
FIREBASE_STATUS_URL=

# GPS trackers: Traccar's position forwarding sends this (16+ characters).
HUB_DEVICE_TOKEN=
# scripts/replay.mjs (demos only): it can move ANY unit, so leave empty in real use.
HUB_SIMULATOR_TOKEN=

# Feature flags (handoff §2.4). "0" switches a feature off.
FEATURE_RESPONDER_TRACKING=1
FEATURE_HOTLINE_INTAKE=1
FEATURE_CITIZEN_ETA_UPDATES=1
