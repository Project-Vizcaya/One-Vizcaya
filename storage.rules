rules_version = '2';

// Firebase Storage security rules for One Vizcaya.
//
// Read access mirrors the role model in firestore.rules: a citizen may read
// only their OWN uploads, and only authorised admin tiers may read others'.
// Previously both paths were `allow read: if isAuth()`, which let any signed-in
// citizen fetch any report photo — and, more seriously, any resident's uploaded
// government ID / barangay certificate — if they knew or guessed the path.
// Scoping the file itself (not just the Firestore metadata around it) is what a
// data-privacy assessment under RA 10173 expects.
//
// Uploads are named "<uid>_<timestamp>.jpg" (report_problem_screen.dart:149,
// residency_verification_screen.dart:115). Firebase Auth uids are alphanumeric
// and contain no underscore, so the first "_"-separated segment identifies the
// owner reliably.
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    // The uid prefix of "<uid>_<timestamp>.jpg" is the uploader.
    function isOwner(fileName) {
      return isAuth() && fileName.split('_')[0] == request.auth.uid;
    }

    // Storage rules cannot read Auth custom claims, so the caller's role comes
    // from their Firestore profile — the same fallback firestore.rules uses.
    // Evaluated only after isOwner() fails, so a citizen reading their own file
    // costs no extra Firestore read.
    function isAnyAdmin() {
      return isAuth() && firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data.get('role', '') in [
        'barangay_admin', 'municipal_admin', 'provincial_admin', 'admin', 'super_admin'
      ];
    }

    // Report photo evidence. Files are named "<uid>_<timestamp>.jpg".
    match /report_images/{imageId} {
      // The reporter may view their own evidence; admins view it to triage.
      // The citizen "Recently Resolved" community feed renders no photos
      // (community_feed.dart), so it is unaffected by this scoping.
      // `get`, not `read`: nobody may LIST the folder and enumerate files.
      allow get: if isOwner(imageId) || isAnyAdmin();

      // Authenticated users may upload, but only JPEG/PNG images up to 10 MB
      // (client compresses to ~200 KB; this is a safety ceiling).
      allow create: if isAuth()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');

      // Evidence is immutable from the client; deletion is handled server-side
      // by Cloud Functions (account deletion / retention cleanup).
      allow update, delete: if false;
    }

    // Residency-proof documents for the certification path — uploaded
    // government IDs and barangay certificates. Files are "<uid>_<timestamp>.jpg".
    match /residency_proofs/{docId} {
      // Only the resident who uploaded it and the admins who review the
      // certification queue may read it.
      // `get`, not `read`: nobody may LIST the folder and enumerate files.
      allow get: if isOwner(docId) || isAnyAdmin();

      allow create: if isAuth()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');

      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
